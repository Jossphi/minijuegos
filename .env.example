# Cadena de conexión de Neon (usa la "pooled" connection string)
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Contraseña para entrar al panel /admin
ADMIN_PASSWORD=cambia-esto
# Secreto largo y aleatorio para firmar la sesión del admin (openssl rand -base64 32)
SESSION_SECRET=
# Secreto largo y aleatorio para cifrar los resultados del sorteo (openssl rand -base64 32). ¡No lo cambies una vez empezado el sorteo!
DRAW_SECRET=
